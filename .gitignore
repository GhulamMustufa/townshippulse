# TownshipPulse Production .gitignore
# Sime Darby Property Hackathon 2026 - Zero Credential Leakage

# Dependencies
/node_modules
/.pnp
.pnp.js

# Production Next.js & Build Outputs
/.next/
/out/
/build
/dist

# Environment variables & secrets (CRITICAL: NEVER COMMIT)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
.env.local
*.env
*.pem
*.key
*.cert
*.secret

# Allow .env.example template ONLY
!.env.example

# Vercel Deployment & Project State
.vercel

# Debugging and Logging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and Editor settings
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing & Artifact outputs
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
