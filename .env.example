# ==============================================================================
# TownshipPulse — Environment Configuration Template
# Sime Darby Property University Hackathon 2026
# ==============================================================================
# All environment variables are OPTIONAL. The application runs with 100%
# functionality out-of-the-box using built-in heuristic fallbacks and seed data.
# When DATABASE_URL is configured, all devices live-sync via Neon Serverless Postgres.
# ==============================================================================

# 1. OpenAI Multimodal Vision API Key (Recommended: gpt-4o-mini)
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 2. Google Gemini Multimodal Vision API Key (Alternative: gemini-1.5-flash)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# 3. Neon Serverless PostgreSQL Database URL (Singapore ap-southeast-1)
# Used for live multi-device syncing across judges' phones and stage dashboard.
# (If omitted, automatically falls back to robust in-memory store)
DATABASE_URL=postgres://neondb_owner:YOUR_PASSWORD@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 4. Server Port (Default is 3001)
PORT=3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
